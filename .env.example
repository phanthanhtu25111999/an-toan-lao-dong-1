# Copy file này thành .env.local và điền giá trị thật (không commit .env.local lên git)

# API key lấy tại https://resend.com/api-keys (miễn phí) — dùng để website
# gửi email thông báo mỗi khi có khách điền form Liên hệ.
RESEND_API_KEY=

# (Tuỳ chọn) Đổi email nhận thông báo form liên hệ — mặc định lấy theo
# site-config.ts. Hữu ích khi test local hoặc khi Resend chưa verify domain
# (tài khoản Resend miễn phí chỉ gửi được tới email bạn dùng để đăng ký).
CONTACT_TO_EMAIL=

# Tên miền thật của website khi đã đăng ký (dùng cho SEO/metadata).
NEXT_PUBLIC_SITE_URL=

# (Tuỳ chọn) Google Ads Conversion ID, dạng "AW-XXXXXXXXX", lấy trong
# Google Ads > Tools > Conversions. Để trống thì tag không được gắn vào trang.
NEXT_PUBLIC_GOOGLE_ADS_ID=
