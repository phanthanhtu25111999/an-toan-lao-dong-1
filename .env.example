# Copy file này thành .env.local và điền giá trị thật (không commit .env.local lên git)

# API key lấy tại https://resend.com/api-keys (miễn phí) — dùng để website
# gửi email thông báo mỗi khi có khách điền form Liên hệ.
RESEND_API_KEY=

# Tên miền thật của website khi đã đăng ký (dùng cho SEO/metadata).
NEXT_PUBLIC_SITE_URL=
